{
  "name": "modular_bot_template",
  "version": "1.0.0",
  "description": "modular bot template built using discord.js to be used as the foundation for quickly creating new bots",
  "main": "bot.js",
  "repository": "https://github.com/agentv9/Modular-DIscord-Bot-Template",
  "author": "kaseknife95",
  "license": "MIT",
  "imports": {
    "#core/*": "./src/core/*.js",
    "#modules/*": "./src/modules/*.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/bot.js",
    "dev": "tsx src/bot.ts"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
